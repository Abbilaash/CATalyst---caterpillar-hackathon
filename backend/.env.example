# ========================================
# DATABASE CONFIGURATIONS
# ========================================

# MongoDB connection string (Used for User authentication and NoSQL data)
# Replace <username> and <password> with your Atlas cluster details
MONGO_URI="mongodb+srv://<username>:<password>@<cluster_name>.mongodb.net/rental_tracking?retryWrites=true&w=majority"

# PostgreSQL connection string (Used for Assets, Sites, Rentals, and Telemetry)
# Replace <username>, <password>, and <db_name> with your local setup
POSTGRES_URI="postgresql://<username>:<password>@localhost:5432/<db_name>"


# ========================================
# SECURITY & AUTHENTICATION
# ========================================

# Secret key used for signing JWT tokens (do NOT share this in production!)
# Generate a secure one using: openssl rand -hex 32
SECRET_KEY="your-super-secret-key-change-this-in-production"

# Hashing algorithm used by the JWT tokens
ALGORITHM="HS256"

# Expiration time for access tokens in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=1440
